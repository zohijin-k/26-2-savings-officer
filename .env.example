# 전북AI OCR 설정. 저장소 루트에 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 코드는 .env를 직접 읽지 않는다. 백엔드를 `uvicorn demo.backend.main:app --env-file .env`로 실행한다.

# 전북AI OCR API 주소. 비우면 https://ai.jb.go.kr/open-api/v1
JBAI_BASE_URL=
# 도청에서 발급받은 API 키
JBAI_API_KEY=
# 실제 신청 서류를 전북AI OCR로 보내도 되는지 (true / false).
# 기관 확인에 따라 데모에서는 true로 둔다. true이고 JBAI_API_KEY가 있을 때만 전북AI를 기본 판독으로 쓴다.
# 비우거나 false면 전북AI를 부르지 않고 지금처럼 로컬 OCR(Apple Vision 등)부터 판독한다.
JBAI_ALLOW_REAL_DOCS=
# (선택) 전북AI 요청 한 건의 시간 제한(초). 비우면 60. 넘으면 로컬 OCR로 대체한다.
JBAI_TIMEOUT_SEC=
# (선택) 생성 응답 최대 토큰 수. 비우면 4096.
JBAI_MAX_TOKENS=

# ── 담당자 화면 'AI 종합의견' (선택) ─────────────────────────────────────────
# 저장된 판정을 전북AI LLM으로 요약해 최종 판정 패널 맨 위에 보인다. 판정은 바꾸지 않는다.
# 아래 두 값이 모두 있어야 켜진다. 비우면 규칙 기반 요약을 보인다(외부 전송 없음).
# 전송 범위는 .trellis/spec/backend/officer-summary.md 의 허용목록뿐이다(이름·주소·연락처 등 제외).
PROGRAM_LLM_ENABLED=
# jbai 로 둔다.
PROGRAM_LLM_PROVIDER=
# 비우면 MainModel
JBAI_LLM_MODEL=
# json_object(기본) 또는 prompt. 형식 오류 시 prompt로 한 번 다시 부른다.
JBAI_RESPONSE_FORMAT=
# 요청 한 건의 시간 제한(초). 비우면 30.
JBAI_LLM_TIMEOUT_SEC=
# 제출된 신청의 종합의견을 접수 순서대로 미리 만들어 둔다. false면 담당자가 열 때 만든다.
OFFICER_SUMMARY_PREFETCH=
