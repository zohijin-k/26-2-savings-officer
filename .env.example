# 전북AI OCR 설정. 저장소 루트에 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 코드는 .env를 직접 읽지 않는다. 백엔드를 `uvicorn demo.backend.main:app --env-file .env`로 실행한다.

# 전북AI OCR API 주소. 비우면 https://ai.jb.go.kr/open-api/v1
JBAI_BASE_URL=
# 도청에서 발급받은 API 키
JBAI_API_KEY=
# 실제 신청 서류를 전북AI OCR로 보내도 되는지 (true / false).
# 제출·시연에서는 비워 두거나 false로 둔다(demo/docs/demo-script.md: 이번 제출에서 전북AI는 쓰지 않는다).
# 비우거나 false면 전북AI를 부르지 않고 로컬 OCR(Apple Vision 등)부터 판독한다.
# true이고 JBAI_API_KEY가 있으면 스캔 서류(글자층 없는 PDF·사진: 초본·등본·납부확인서·자격득실)의
# 쪽 그림이 ai.jb.go.kr(전북AI)로 전송된다. 켜기 전에 기관 확인을 받는다.
JBAI_ALLOW_REAL_DOCS=false
# (선택) 전북AI 요청 한 건의 시간 제한(초). 비우면 60. 넘으면 로컬 OCR로 대체한다.
JBAI_TIMEOUT_SEC=
# (선택) 생성 응답 최대 토큰 수. 비우면 4096.
JBAI_MAX_TOKENS=
